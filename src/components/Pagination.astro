---
import NextIcon from '@icons/NextIcon.astro';
import PrevIcon from '@icons/PrevIcon.astro';

const { length, currentPage, firstUrl, prevUrl, nextUrl } = Astro.props;
const paginationList = Array.from({ length }, (_, i) => i + 1);
---

<nav class="pagination" aria-label="Pagination">

  <span class="pagination__label">
    PAGE::
  </span>

  <ol class="pagination__list">

    {
      prevUrl ? (
        <li class="pagination__item">

          <a
            href={prevUrl}
            class="pagination__link pagination__link--arrow rtl:rotate-180"
          >
            <span class="sr-only">
              Previous Page
            </span>

            <PrevIcon />
          </a>

        </li>
      ) : null
    }


    {
      paginationList?.map((num) => (

        <li class="pagination__item">

          <a
            href={`${firstUrl}${num == 1 ? '' : '' + num}`}
            class:list={[
              'pagination__link',
              'pagination__number',
              {
                'pagination__link--active': currentPage == num,
              },
            ]}
            aria-current={currentPage == num ? 'page' : undefined}
          >
            {String(num).padStart(2, '0')}
          </a>

        </li>

      ))
    }


    {
      nextUrl ? (
        <li class="pagination__item">

          <a
            href={nextUrl}
            class="pagination__link pagination__link--arrow rtl:rotate-180"
          >
            <span class="sr-only">
              Next Page
            </span>

            <NextIcon />
          </a>

        </li>
      ) : null
    }

  </ol>

</nav>


<style>

/* ================================================================
   PAGINATION
================================================================ */

.pagination {

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  gap:
    0.75rem;

  width:
    min(
      calc(100% - 2rem),
      64rem
    );

  margin:
    3rem auto 0;

  padding-top:
    0.75rem;

  border-top:
    1px dashed
    #a1a69f;

}


:global(.dark) .pagination {

  border-color:
    #3b453f;

}


/* ================================================================
   LABEL
================================================================ */

.pagination__label {

  flex-shrink:
    0;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.45rem;

  font-weight:
    700;

  letter-spacing:
    0.08em;

  color:
    #7b837e;

}


/* ================================================================
   LIST
================================================================ */

.pagination__list {

  display:
    flex;

  align-items:
    center;

  gap:
    0.4rem;

  margin:
    0;

  padding:
    0;

  list-style:
    none;

}


/* ================================================================
   ITEM
================================================================ */

.pagination__item {

  margin:
    0;

  padding:
    0;

}


/* ================================================================
   LINK
================================================================ */

.pagination__link {

  display:
    inline-flex;

  align-items:
    center;

  justify-content:
    center;

  width:
    30px;

  height:
    30px;

  background:
    #ded9cc;

  border:
    1px solid
    #829187;

  color:
    #303936;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.48rem;

  font-weight:
    700;

  text-decoration:
    none;

  transition:
    transform 0.12s steps(2),
    box-shadow 0.12s steps(2),
    background 0.12s steps(2);

}


:global(.dark) .pagination__link {

  background:
    #151b18;

  border-color:
    #4e5b53;

  color:
    #d2d8d3;

}


/* ================================================================
   HOVER
================================================================ */

.pagination__link:hover {

  transform:
    translate(1px, 1px);

  background:
    #d3cec1;

  box-shadow:
    2px 2px 0
    #303936;

}


:global(.dark) .pagination__link:hover {

  background:
    #1b231f;

  box-shadow:
    2px 2px 0
    #4e5b53;

}


/* ================================================================
   ACTIVE
================================================================ */

.pagination__link--active {

  background:
    #303936;

  border-color:
    #303936;

  color:
    #e8e3d7;

  box-shadow:
    2px 2px 0
    #63776b;

}


:global(.dark) .pagination__link--active {

  background:
    #63776b;

  border-color:
    #63776b;

  color:
    #f0eee7;

  box-shadow:
    2px 2px 0
    #303936;

}


/* ================================================================
   ARROWS
================================================================ */

.pagination__link--arrow {

  border-color:
    #303936;

}


.pagination__link--arrow :global(svg) {

  width:
    0.7rem;

  height:
    0.7rem;

}


.pagination__link--arrow:hover {

  color:
    #63776b;

}


/* ================================================================
   MOBILE
================================================================ */

@media (max-width: 640px) {

  .pagination {

    width:
      min(
        calc(100% - 1rem),
        64rem
      );

    gap:
      0.5rem;

  }


  .pagination__list {

    gap:
      0.25rem;

  }


  .pagination__link {

    width:
      27px;

    height:
      27px;

    font-size:
      0.42rem;

  }


  .pagination__label {

    display:
      none;

  }

}


/* ================================================================
   REDUCED MOTION
================================================================ */

@media (prefers-reduced-motion: reduce) {

  .pagination__link {

    transition:
      none;

  }

}

</style>