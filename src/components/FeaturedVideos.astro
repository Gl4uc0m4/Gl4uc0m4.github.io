---
import { Image } from 'astro:assets';
import youtube from '@config/youtube.json';
---

<section class="youtube-section">

  <!-- CABECERA -->

  <div class="youtube-heading">

    <div class="youtube-heading__left">

      <span class="youtube-kicker">
        MEDIA::ARCHIVE
      </span>

      <h3>
        Recommended videos
      </h3>

    </div>

    <span class="youtube-heading__status">
      [ YOUTUBE ]
    </span>

  </div>


  <!-- VIDEOS -->

  <ul class="youtube-grid">

    {
      youtube?.slice(0, 3).map((item) => (

        <li class="youtube-card">

          <a
            href={`https://www.youtube.com/watch?v=${item.videoId}`}
            target="_blank"
            rel="noopener noreferrer"
            class="youtube-link"
          >

            <!-- IMAGEN -->

            <figure class="youtube-image">

              <Image
                alt={item.title}
                src={`https://i.ytimg.com/vi/${item.videoId}/maxresdefault.jpg`}
                class="youtube-thumbnail"
                width={309}
                height={176}
                decoding="async"
                loading="lazy"
              />

              <span class="youtube-play">
                ▶
              </span>

              <span class="youtube-index">
                VIDEO
              </span>

            </figure>


            <!-- INFORMACIÓN -->

            <div class="youtube-info">

              <div class="youtube-channel">

                <span class="youtube-dot"></span>

                {item.channelTitle}

              </div>

              <p class="youtube-title">
                {item.title}
              </p>

              <div class="youtube-footer">
                <span>WATCH::VIDEO</span>
                <span>&gt;&gt;</span>
              </div>

            </div>

          </a>

        </li>

      ))
    }

  </ul>

</section>


<style>

/* ================================================================
   SECTION
================================================================ */

.youtube-section {

  position:
    relative;

  width:
    min(
      calc(100% - 2rem),
      64rem
    );

  margin-inline:
    auto;

  padding-bottom:
    3rem;

}


/* ================================================================
   GRID DE FONDO
================================================================ */

.youtube-section::before {

  content:
    '';

  position:
    absolute;

  inset:
    0;

  z-index:
    -1;

  pointer-events:
    none;

  background-image:
    linear-gradient(
      to right,
      rgb(48 57 54 / 0.035) 1px,
      transparent 1px
    ),
    linear-gradient(
      to bottom,
      rgb(48 57 54 / 0.035) 1px,
      transparent 1px
    );

  background-size:
    20px 20px;

}


/* ================================================================
   DARK GRID
================================================================ */

:global(.dark) .youtube-section::before {

  background-image:
    linear-gradient(
      to right,
      rgb(255 255 255 / 0.018) 1px,
      transparent 1px
    ),
    linear-gradient(
      to bottom,
      rgb(255 255 255 / 0.018) 1px,
      transparent 1px
    );

}


/* ================================================================
   HEADING
================================================================ */

.youtube-heading {

  display:
    flex;

  align-items:
    flex-end;

  justify-content:
    space-between;

  gap:
    1rem;

  margin-bottom:
    1rem;

  padding-bottom:
    0.7rem;

  border-bottom:
    2px solid
    #303936;

}


:global(.dark) .youtube-heading {

  border-color:
    #4b5951;

}


/* ================================================================
   KICKER
================================================================ */

.youtube-kicker {

  display:
    block;

  margin-bottom:
    0.25rem;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.48rem;

  font-weight:
    700;

  letter-spacing:
    0.12em;

  color:
    #7b837e;

}


/* ================================================================
   TITLE
================================================================ */

.youtube-heading h3 {

  margin:
    0;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    1rem;

  font-weight:
    800;

  line-height:
    1.2;

  letter-spacing:
    0.02em;

  text-transform:
    uppercase;

  color:
    #303936;

}


:global(.dark) .youtube-heading h3 {

  color:
    #d6ddd8;

}


/* ================================================================
   STATUS
================================================================ */

.youtube-heading__status {

  flex-shrink:
    0;

  padding:
    4px 7px;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.48rem;

  font-weight:
    700;

  letter-spacing:
    0.08em;

  color:
    #63776b;

  border:
    1px solid
    #829187;

  background:
    rgb(99 119 107 / 0.06);

}


/* ================================================================
   GRID
================================================================ */

.youtube-grid {

  display:
    grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap:
    1rem;

  margin:
    0;

  padding:
    0;

  list-style:
    none;

}


/* ================================================================
   CARD
================================================================ */

.youtube-card {

  position:
    relative;

}


/* ================================================================
   LINK
================================================================ */

.youtube-link {

  position:
    relative;

  display:
    block;

  overflow:
    hidden;

  background:
    #ded9cc;

  border:
    2px solid
    #303936;

  box-shadow:
    4px 4px 0
    #303936;

  text-decoration:
    none;

  transition:
    transform 0.12s steps(2),
    box-shadow 0.12s steps(2);

}


:global(.dark) .youtube-link {

  background:
    #151b18;

  border-color:
    #4e5b53;

  box-shadow:
    4px 4px 0
    #4e5b53;

}


/* ================================================================
   HOVER
================================================================ */

.youtube-link:hover {

  transform:
    translate(2px, 2px);

  box-shadow:
    2px 2px 0
    #303936;

}


:global(.dark) .youtube-link:hover {

  box-shadow:
    2px 2px 0
    #4e5b53;

}


/* ================================================================
   IMAGE
================================================================ */

.youtube-image {

  position:
    relative;

  margin:
    0;

  aspect-ratio:
    16 / 9;

  overflow:
    hidden;

  background:
    #c9c5b9;

  border-bottom:
    2px solid
    #303936;

}


:global(.dark) .youtube-image {

  background:
    #0d110f;

  border-color:
    #4e5b53;

}


/* ================================================================
   THUMBNAIL
================================================================ */

.youtube-thumbnail {

  width:
    100%;

  height:
    100%;

  object-fit:
    cover;

  display:
    block;

  transition:
    transform 0.2s steps(3);

}


.youtube-link:hover .youtube-thumbnail {

  transform:
    scale(1.035);

}


/* ================================================================
   PLAY BUTTON
================================================================ */

.youtube-play {

  position:
    absolute;

  left:
    50%;

  top:
    50%;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  width:
    42px;

  height:
    32px;

  transform:
    translate(-50%, -50%);

  background:
    #303936;

  border:
    2px solid
    #e8e3d7;

  color:
    #e8e3d7;

  font-size:
    0.75rem;

  opacity:
    0.92;

  transition:
    transform 0.12s steps(2),
    background 0.12s steps(2);

}


.youtube-link:hover .youtube-play {

  transform:
    translate(-50%, -50%)
    scale(1.08);

  background:
    #63776b;

}


/* ================================================================
   VIDEO LABEL
================================================================ */

.youtube-index {

  position:
    absolute;

  top:
    7px;

  left:
    7px;

  padding:
    3px 5px;

  background:
    rgb(24 30 27 / 0.88);

  color:
    #d8ddd8;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.42rem;

  font-weight:
    700;

  letter-spacing:
    0.08em;

}


/* ================================================================
   INFO
================================================================ */

.youtube-info {

  padding:
    0.8rem;

}


/* ================================================================
   CHANNEL
================================================================ */

.youtube-channel {

  display:
    flex;

  align-items:
    center;

  gap:
    6px;

  overflow:
    hidden;

  white-space:
    nowrap;

  text-overflow:
    ellipsis;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.52rem;

  font-weight:
    700;

  letter-spacing:
    0.03em;

  text-transform:
    uppercase;

  color:
    #6e7771;

}


/* ================================================================
   DOT
================================================================ */

.youtube-dot {

  width:
    5px;

  height:
    5px;

  flex-shrink:
    0;

  background:
    #63776b;

}


/* ================================================================
   TITLE
================================================================ */

.youtube-title {

  display:
    -webkit-box;

  overflow:
    hidden;

  height:
    2.5rem;

  margin:
    0.45rem 0 0;

  font-family:
    'Source Sans 3',
    sans-serif;

  font-size:
    0.82rem;

  font-weight:
    600;

  line-height:
    1.45;

  color:
    #303936;

  -webkit-line-clamp:
    2;

  -webkit-box-orient:
    vertical;

}


:global(.dark) .youtube-title {

  color:
    #d2d8d3;

}


/* ================================================================
   FOOTER
================================================================ */

.youtube-footer {

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  margin-top:
    0.75rem;

  padding-top:
    0.5rem;

  border-top:
    1px dashed
    #a1a69f;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.43rem;

  font-weight:
    700;

  letter-spacing:
    0.05em;

  color:
    #7b837e;

}


:global(.dark) .youtube-footer {

  border-color:
    #3b453f;

}


/* ================================================================
   TABLET
================================================================ */

@media (max-width: 900px) {

  .youtube-grid {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

  }

}


/* ================================================================
   MOBILE
================================================================ */

@media (max-width: 640px) {

  .youtube-section {

    width:
      min(
        calc(100% - 1rem),
        64rem
      );

  }


  .youtube-grid {

    grid-template-columns:
      1fr;

    gap:
      0.9rem;

  }


  .youtube-heading {

    align-items:
      center;

  }


  .youtube-heading h3 {

    font-size:
      0.85rem;

  }


  .youtube-heading__status {

    font-size:
      0.42rem;

  }

}


/* ================================================================
   REDUCED MOTION
================================================================ */

@media (prefers-reduced-motion: reduce) {

  .youtube-link,
  .youtube-thumbnail,
  .youtube-play {

    transition:
      none;

  }

}

</style>