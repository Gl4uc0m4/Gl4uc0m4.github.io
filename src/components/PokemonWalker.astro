---
const pokemon = [
  'wannacry',
  'emotet',
  'mirai',
  'lockbit',
  'rat',
  'phishing',
  'trickbot',
  'crow',
  'macro',
  'exfil',
];
---

<div class="pokemon-world" aria-hidden="true">

  <div class="pokemon-hud">
    <span class="pokemon-hud__dot"></span>
    <span>MALMONS::SYSTEM</span>
  </div>

  <div
    class="pokemon-parade"
    id="pokemon-parade"
  >

    {
      pokemon
        .sort(() => Math.random() - 0.5)
        .slice(0, 3)
        .map((currentPokemon) => (

          <div class="pokemon-walker">

            <div class="pokemon-shadow"></div>

            <img
              class="pokemon-sprite"
              src={`/pokemon/${currentPokemon}.png`}
              alt=""
              draggable="false"
            />

            <span class="pokemon-name">
              {currentPokemon.toUpperCase()}
            </span>

          </div>

        ))
    }

  </div>

</div>


<script>

  /*
   * ============================================================
   * CONFIGURACIÓN
   * ============================================================
   */

  const SPEED = 120;


  /*
   * ============================================================
   * ELEMENTO
   * ============================================================
   */

  const parade =
    document.getElementById(
      'pokemon-parade'
    );


  /*
   * ============================================================
   * ESTADO
   * ============================================================
   */

  let x = 0;

  let lastTime =
    performance.now();

  let animationFrame = 0;


  /*
   * ============================================================
   * RESET
   * ============================================================
   */

  const reset = () => {

    if (!parade) {
      return;
    }

    /*
     * Medimos el ancho REAL de la fila.
     */

    const paradeWidth =
      parade.offsetWidth;


    /*
     * Empezamos completamente
     * fuera de la pantalla.
     */

    x =
      -paradeWidth;


    lastTime =
      performance.now();


    parade.style.transform =
      `translate3d(${x}px, 0, 0)`;

  };


  /*
   * ============================================================
   * ANIMACIÓN
   * ============================================================
   */

  const animate = (time) => {

    if (!parade) {
      return;
    }


    /*
     * Tiempo transcurrido.
     */

    const delta =
      Math.min(
        time - lastTime,
        50
      );

    lastTime =
      time;


    /*
     * Mover TODA la fila.
     */

    x +=
      SPEED *
      (delta / 1000);


    parade.style.transform =
      `translate3d(${x}px, 0, 0)`;


    /*
     * Cuando ha salido toda la fila
     * por la derecha, vuelve a empezar.
     */

    const paradeWidth =
      parade.offsetWidth;


    if (
      x >
      window.innerWidth
    ) {

      x =
        -paradeWidth;

    }


    animationFrame =
      requestAnimationFrame(
        animate
      );

  };


  /*
   * ============================================================
   * START
   * ============================================================
   */

  const start = () => {

    /*
     * Evita animaciones duplicadas
     * con ViewTransitions.
     */

    if (animationFrame) {

      cancelAnimationFrame(
        animationFrame
      );

    }


    reset();


    animationFrame =
      requestAnimationFrame(
        animate
      );

  };


  /*
   * Primera carga.
   */

  start();


  /*
   * ============================================================
   * ASTRO VIEW TRANSITIONS
   * ============================================================
   */

  document.addEventListener(
    'astro:page-load',
    start
  );

</script>


<style>

/* ================================================================
   WORLD
================================================================ */

.pokemon-world {

  position: fixed;

  left: 0;

  right: 0;

  bottom: 0;

  height: 150px;

  z-index: 40;

  pointer-events: none;

  overflow: hidden;

}


/* ================================================================
   HUD
================================================================ */

.pokemon-hud {

  position: absolute;

  right: 16px;

  bottom: 12px;

  display: flex;

  align-items: center;

  gap: 6px;

  padding: 5px 8px;

  background:
    rgb(var(--px-panel, 20 25 34) / 0.9);

  border:
    1px solid
    rgb(var(--px-border, 42 52 65));

  color:
    rgb(var(--color-text-body));

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.38rem;

  font-weight:
    800;

  letter-spacing:
    0.08em;

  opacity:
    0.65;

}


.pokemon-hud__dot {

  width: 5px;

  height: 5px;

  background:
    rgb(var(--color-primary));

}


/* ================================================================
   PARADE
================================================================ */

.pokemon-parade {

  position: absolute;

  left: 0;

  bottom: 5px;

  display: flex;

  align-items: flex-end;

  gap: 0;

  height: 120px;

  width: max-content;

  will-change:
    transform;

}


/* ================================================================
   POKÉMON
================================================================ */

.pokemon-walker {

  position: relative;

  flex: 0 0 100px;

  width: 100px;

  height: 120px;

  display: flex;

  align-items: flex-end;

  justify-content: center;

}


/* ================================================================
   SPRITE
================================================================ */

.pokemon-sprite {

  position: relative;

  z-index: 2;

  width: 95px;

  height: 95px;

  object-fit: contain;

  image-rendering:
    pixelated;

  image-rendering:
    crisp-edges;

  user-select:
    none;

  pointer-events:
    none;

  animation:
    pokemon-step
    0.55s
    steps(2)
    infinite;

}


/* ================================================================
   WALK
================================================================ */

@keyframes pokemon-step {

  0% {

    transform:
      translateY(0);

  }

  50% {

    transform:
      translateY(-3px);

  }

  100% {

    transform:
      translateY(0);

  }

}


/* ================================================================
   SHADOW
================================================================ */

.pokemon-shadow {

  position: absolute;

  left: 50%;

  bottom: 3px;

  width: 55px;

  height: 8px;

  transform:
    translateX(-50%);

  background:
    rgb(0 0 0 / 0.25);

  border-radius:
    50%;

  animation:
    pokemon-shadow
    0.55s
    steps(2)
    infinite;

}


@keyframes pokemon-shadow {

  0% {

    transform:
      translateX(-50%)
      scaleX(1);

  }

  50% {

    transform:
      translateX(-50%)
      scaleX(0.85);

  }

  100% {

    transform:
      translateX(-50%)
      scaleX(1);

  }

}


/* ================================================================
   NOMBRE
================================================================ */

.pokemon-name {

  position: absolute;

  z-index: 5;

  left: 50%;

  bottom: 94px;

  transform:
    translateX(-50%);

  padding:
    4px 6px;

  white-space:
    nowrap;

  background:
    rgb(var(--px-panel, 20 25 34) / 0.95);

  border:
    1px solid
    rgb(var(--px-border, 42 52 65));

  color:
    rgb(var(--color-text-body));

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.35rem;

  font-weight:
    800;

  letter-spacing:
    0.05em;

  opacity:
    0;

  transition:
    opacity
    0.15s
    steps(2);

}


.pokemon-walker:hover .pokemon-name {

  opacity:
    1;

}


/* ================================================================
   MOBILE
================================================================ */

@media (max-width: 767px) {

  .pokemon-world {

    height:
      105px;

  }


  .pokemon-parade {

    height:
      85px;

  }


  .pokemon-walker {

    flex-basis:
      75px;

    width:
      75px;

    height:
      85px;

  }


  .pokemon-sprite {

    width:
      70px;

    height:
      70px;

  }


  .pokemon-shadow {

    width:
      40px;

    height:
      6px;

  }


  .pokemon-name,
  .pokemon-hud {

    display:
      none;

  }

}


/* ================================================================
   REDUCED MOTION
================================================================ */

@media (prefers-reduced-motion: reduce) {

  .pokemon-world {

    display:
      none;

  }

}

</style>