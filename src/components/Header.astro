---
import { Image } from 'astro:assets';
import menu from '@config/menu.json';
import config from '@config/config.json';
import HamburgerIcon from '@icons/HamburgerIcon.astro';
import CloseIcon from '@icons/CloseIcon.astro';
import HomeIcon from '@icons/HomeIcon.astro';
import ThemeIcon from '@components/ThemeIcon.astro';

export interface NavigationLink {
  name: string;
  url: string;
}

const { main }: { main: NavigationLink[] } = menu;
---

<header class="header-shell">

  <!-- Línea decorativa superior -->
  <div class="header-top-line"></div>

  <div class="header-grid">

    <div class="header-inner">

      <!-- =====================================================
           LOGO
      ====================================================== -->

      <a
        href="/"
        class="logo-box"
        aria-label={config.site.title}
      >

        <span class="logo-corner logo-corner--tl"></span>
        <span class="logo-corner logo-corner--tr"></span>
        <span class="logo-corner logo-corner--bl"></span>
        <span class="logo-corner logo-corner--br"></span>

        <div class="logo-inner">

          <div class="block dark:hidden">
            <Image
              src={config.site.logoLight}
              alt={config.site.title}
              class="logo-image"
              width={500}
              height={200}
              decoding="async"
              loading="lazy"
            />
          </div>

          <div class="hidden dark:block">
            <Image
              src={config.site.logoDark}
              alt={config.site.title}
              class="logo-image"
              width={500}
              height={200}
              decoding="async"
              loading="lazy"
            />
          </div>

        </div>

      </a>


      <!-- =====================================================
           DESKTOP NAV
      ====================================================== -->

      <nav class="desktop-nav" aria-label="Main navigation">

        <span class="nav-label">MENU::</span>

        <ul>

          {
            main?.map((item) => (
              <li>

                <a
                  href={item.url}
                  class="nav-item"
                >

                  <span class="nav-marker">&gt;</span>

                  {
                    item.name === 'Home'
                      ? <HomeIcon />
                      : item.name
                  }

                </a>

              </li>
            ))
          }

        </ul>

      </nav>


      <!-- =====================================================
           MOBILE NAV
      ====================================================== -->

      <div class="mobile-nav">

        <input
          id="nav-toggle"
          type="checkbox"
          class="hidden"
        />

        <label
          id="show-button"
          for="nav-toggle"
          class="menu-button"
          aria-label="Open menu"
        >
          <HamburgerIcon />
        </label>

        <label
          id="hide-button"
          for="nav-toggle"
          class="menu-button menu-button--close"
          aria-label="Close menu"
        >
          <CloseIcon />
        </label>

        <div
          id="nav-menu"
          class="nav-dropdown"
        >

          <div class="nav-dropdown__title">
            POKE::MENU
          </div>

          <ul>

            {
              main?.map((item) => (
                <li>

                  <a
                    href={item.url}
                    class="nav-dropdown__link"
                  >
                    <span>&gt;</span>
                    {item.name}
                  </a>

                </li>
              ))
            }

          </ul>

        </div>

      </div>


      <!-- =====================================================
           THEME
      ====================================================== -->

      {config.features.dark_mode && (
        <div class="theme-box">
          <ThemeIcon />
        </div>
      )}

    </div>

    <!-- Barra inferior -->
    <div class="header-status">

      <span class="status-left">
        SYS::ONLINE
      </span>

      <span class="status-center">
        {config.site.title}
      </span>

      <span class="status-right">
        [ READY ]
      </span>

    </div>

  </div>

</header>


<style>

/* ================================================================
   HEADER
================================================================ */

.header-shell {

  position: relative;

  width: 100%;

  background: #e8e3d7;

  color: #303936;

  border-bottom: 2px solid #303936;

}


/* ================================================================
   DARK MODE
================================================================ */

:global(.dark) .header-shell {

  background: #0d1210;

  color: #d5ddd7;

  border-color: #46534b;

}


/* ================================================================
   TOP LINE
================================================================ */

.header-top-line {

  height: 3px;

  background:
    repeating-linear-gradient(
      to right,
      #63776b 0,
      #63776b 18px,
      transparent 18px,
      transparent 22px
    );

  opacity: 0.8;

}


/* ================================================================
   GRID
================================================================ */

.header-grid {

  position: relative;

  background-image:
    linear-gradient(
      to right,
      rgb(48 57 54 / 0.045) 1px,
      transparent 1px
    ),
    linear-gradient(
      to bottom,
      rgb(48 57 54 / 0.045) 1px,
      transparent 1px
    );

  background-size:
    20px 20px;

}


/* ================================================================
   DARK GRID
================================================================ */

:global(.dark) .header-grid {

  background-image:
    linear-gradient(
      to right,
      rgb(255 255 255 / 0.025) 1px,
      transparent 1px
    ),
    linear-gradient(
      to bottom,
      rgb(255 255 255 / 0.025) 1px,
      transparent 1px
    );

}


/* ================================================================
   HEADER INNER
================================================================ */

.header-inner {

  width:
    min(
      calc(100% - 2rem),
      64rem
    );

  min-height:
    86px;

  margin-inline:
    auto;

  display:
    flex;

  align-items:
    center;

  gap:
    1.5rem;

}


/* ================================================================
   LOGO
================================================================ */

.logo-box {

  position:
    relative;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  flex-shrink:
    0;

  width:
    82px;

  height:
    54px;

  background:
    #ddd8ca;

  border:
    2px solid #303936;

  box-shadow:
    4px 4px 0 #303936;

  transition:
    transform 0.12s steps(2),
    box-shadow 0.12s steps(2);

}


/* ================================================================
   LOGO HOVER
================================================================ */

.logo-box:hover {

  transform:
    translate(2px, 2px);

  box-shadow:
    2px 2px 0 #303936;

}


/* ================================================================
   DARK LOGO
================================================================ */

:global(.dark) .logo-box {

  background:
    #171d19;

  border-color:
    #66756c;

  box-shadow:
    4px 4px 0 #66756c;

}


:global(.dark) .logo-box:hover {

  box-shadow:
    2px 2px 0 #66756c;

}


/* ================================================================
   LOGO INNER
================================================================ */

.logo-inner {

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  padding:
    5px 8px;

}


/* ================================================================
   LOGO IMAGE
================================================================ */

.logo-image {

  width:
    64px;

  height:
    auto;

  display:
    block;

}


/* ================================================================
   PIXEL CORNERS
================================================================ */

.logo-corner {

  position:
    absolute;

  width:
    6px;

  height:
    6px;

  background:
    #63776b;

}


.logo-corner--tl {
  top: -2px;
  left: -2px;
}


.logo-corner--tr {
  top: -2px;
  right: -2px;
}


.logo-corner--bl {
  bottom: -2px;
  left: -2px;
}


.logo-corner--br {
  bottom: -2px;
  right: -2px;
}


/* ================================================================
   DESKTOP NAV
================================================================ */

.desktop-nav {

  display:
    flex;

  align-items:
    center;

  gap:
    0.8rem;

  margin-left:
    auto;

}


.desktop-nav ul {

  display:
    flex;

  align-items:
    center;

  gap:
    0.25rem;

  margin:
    0;

  padding:
    0;

  list-style:
    none;

}


/* ================================================================
   NAV LABEL
================================================================ */

.nav-label {

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.55rem;

  font-weight:
    700;

  letter-spacing:
    0.08em;

  color:
    #7a827d;

}


/* ================================================================
   NAV ITEM
================================================================ */

.nav-item {

  position:
    relative;

  display:
    flex;

  align-items:
    center;

  gap:
    5px;

  min-height:
    32px;

  padding:
    0.35rem 0.65rem;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.68rem;

  font-weight:
    700;

  letter-spacing:
    0.04em;

  text-transform:
    uppercase;

  text-decoration:
    none;

  color:
    #303936;

  border:
    1px solid transparent;

  transition:
    background 0.12s steps(2),
    border-color 0.12s steps(2),
    color 0.12s steps(2);

}


:global(.dark) .nav-item {

  color:
    #cbd4ce;

}


/* ================================================================
   NAV MARKER
================================================================ */

.nav-marker {

  color:
    #63776b;

  opacity:
    0;

  transform:
    translateX(-4px);

  transition:
    opacity 0.1s steps(2),
    transform 0.1s steps(2);

}


.nav-item:hover {

  background:
    rgb(99 119 107 / 0.12);

  border-color:
    #63776b;

  color:
    #52675b;

}


:global(.dark) .nav-item:hover {

  background:
    rgb(99 119 107 / 0.15);

  color:
    #9eafa3;

}


.nav-item:hover .nav-marker {

  opacity:
    1;

  transform:
    translateX(0);

}


/* ================================================================
   THEME
================================================================ */

.theme-box {

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  width:
    34px;

  height:
    34px;

  margin-left:
    0.25rem;

  border:
    1px solid #737c76;

  background:
    rgb(255 255 255 / 0.15);

}


/* ================================================================
   MOBILE NAV
================================================================ */

.mobile-nav {

  position:
    relative;

  display:
    none;

  margin-left:
    auto;

}


/* ================================================================
   MENU BUTTON
================================================================ */

.menu-button {

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  width:
    34px;

  height:
    34px;

  cursor:
    pointer;

  color:
    currentColor;

  border:
    1px solid #737c76;

  background:
    rgb(255 255 255 / 0.12);

}


.menu-button:hover {

  background:
    rgb(99 119 107 / 0.15);

  color:
    #52675b;

}


#hide-button {

  display:
    none;

}


/* ================================================================
   MOBILE DROPDOWN
================================================================ */

.nav-dropdown {

  position:
    absolute;

  right:
    0;

  top:
    42px;

  z-index:
    100;

  display:
    none;

  width:
    210px;

  padding:
    8px;

  background:
    #e4dfd2;

  border:
    2px solid #303936;

  box-shadow:
    5px 5px 0 #303936;

}


:global(.dark) .nav-dropdown {

  background:
    #141a17;

  border-color:
    #59665e;

  box-shadow:
    5px 5px 0 #59665e;

}


/* ================================================================
   DROPDOWN TITLE
================================================================ */

.nav-dropdown__title {

  padding:
    6px 8px;

  margin-bottom:
    5px;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.55rem;

  font-weight:
    700;

  letter-spacing:
    0.08em;

  color:
    #737b76;

  border-bottom:
    1px dashed #9da39e;

}


/* ================================================================
   DROPDOWN LINKS
================================================================ */

.nav-dropdown ul {

  margin:
    0;

  padding:
    0;

  list-style:
    none;

}


.nav-dropdown__link {

  display:
    flex;

  align-items:
    center;

  gap:
    8px;

  padding:
    8px;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.68rem;

  font-weight:
    700;

  text-transform:
    uppercase;

  text-decoration:
    none;

  color:
    #303936;

  border:
    1px solid transparent;

}


:global(.dark) .nav-dropdown__link {

  color:
    #cbd4ce;

}


.nav-dropdown__link:hover {

  background:
    rgb(99 119 107 / 0.12);

  border-color:
    #63776b;

  color:
    #52675b;

}


/* ================================================================
   CHECKBOX LOGIC
================================================================ */

#nav-toggle:checked ~ #show-button {

  display:
    none;

}


#nav-toggle:checked ~ #hide-button {

  display:
    flex;

}


#nav-toggle:checked ~ #nav-menu {

  display:
    block;

}


/* ================================================================
   STATUS BAR
================================================================ */

.header-status {

  width:
    min(
      calc(100% - 2rem),
      64rem
    );

  margin-inline:
    auto;

  height:
    22px;

  display:
    grid;

  grid-template-columns:
    1fr auto 1fr;

  align-items:
    center;

  border-top:
    1px solid rgb(48 57 54 / 0.18);

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.48rem;

  font-weight:
    700;

  letter-spacing:
    0.08em;

  color:
    #737b76;

}


:global(.dark) .header-status {

  border-color:
    rgb(255 255 255 / 0.08);

  color:
    #68756d;

}


.status-left {
  text-align:
    left;
}


.status-center {
  text-align:
    center;

  opacity:
    0.7;
}


.status-right {
  text-align:
    right;
}


/* ================================================================
   MOBILE
================================================================ */

@media (max-width: 767px) {

  .header-inner {

    min-height:
      70px;

    gap:
      0.75rem;

  }


  .desktop-nav {

    display:
      none;

  }


  .mobile-nav {

    display:
      block;

  }


  .theme-box {

    margin-left:
      0;

  }


  .logo-box {

    width:
      76px;

    height:
      48px;

  }


  .logo-image {

    width:
      58px;

  }


  .header-status {

    grid-template-columns:
      1fr auto;

  }


  .status-center {

    display:
      none;

  }

}


/* ================================================================
   REDUCED MOTION
================================================================ */

@media (prefers-reduced-motion: reduce) {

  .logo-box,
  .nav-item,
  .nav-marker,
  .menu-button {

    transition:
      none;

  }

}

</style>