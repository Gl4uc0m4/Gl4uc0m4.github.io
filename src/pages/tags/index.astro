---
import Base from '@layouts/Base.astro';
import { getTaxonomy } from '@utils/getAllTags';

const tags = await getTaxonomy('blog', 'tags');
---

<Base>
  <section class="tags-section">

    <!-- CABECERA -->

    <div class="tags-heading">

      <div class="tags-heading__left">

        <span class="tags-kicker">
          SYSTEM::TAXONOMY
        </span>

        <h1>
          Tags
        </h1>

      </div>

      <span class="tags-heading__status">
        [ INDEX ]
      </span>

    </div>


    <!-- TAGS -->

    <ul class="tags-grid">

      {
        tags.map((tag, index) => (

          <li class="tags-item">

            <a
              href={`/tags/${tag.slug}`}
              title={`View posts with the tag: ${tag.name}`}
              class="tags-link"
            >

              <span class="tags-index">
                {String(index + 1).padStart(2, '0')}
              </span>

              <span class="tags-name">
                {tag.name}
              </span>

              <span class="tags-arrow">
                &gt;&gt;
              </span>

            </a>

          </li>

        ))
      }

    </ul>


    <!-- FOOTER -->

    <div class="tags-footer">

      <span>
        TOTAL:: {tags.length}
      </span>

      <span>
        STATUS:: READY
      </span>

    </div>

  </section>
</Base>


<style>

/* ================================================================
   SECTION
================================================================ */

.tags-section {

  position:
    relative;

  width:
    min(
      calc(100% - 2rem),
      64rem
    );

  margin-inline:
    auto;

  padding-bottom:
    3rem;

}


/* ================================================================
   GRID DE FONDO
================================================================ */

.tags-section::before {

  content:
    '';

  position:
    absolute;

  inset:
    0;

  z-index:
    -1;

  pointer-events:
    none;

  background-image:
    linear-gradient(
      to right,
      rgb(48 57 54 / 0.035) 1px,
      transparent 1px
    ),
    linear-gradient(
      to bottom,
      rgb(48 57 54 / 0.035) 1px,
      transparent 1px
    );

  background-size:
    20px 20px;

}


/* ================================================================
   DARK GRID
================================================================ */

:global(.dark) .tags-section::before {

  background-image:
    linear-gradient(
      to right,
      rgb(255 255 255 / 0.018) 1px,
      transparent 1px
    ),
    linear-gradient(
      to bottom,
      rgb(255 255 255 / 0.018) 1px,
      transparent 1px
    );

}


/* ================================================================
   HEADING
================================================================ */

.tags-heading {

  display:
    flex;

  align-items:
    flex-end;

  justify-content:
    space-between;

  gap:
    1rem;

  margin-bottom:
    1rem;

  padding-bottom:
    0.7rem;

  border-bottom:
    2px solid
    #303936;

}


:global(.dark) .tags-heading {

  border-color:
    #4b5951;

}


/* ================================================================
   KICKER
================================================================ */

.tags-kicker {

  display:
    block;

  margin-bottom:
    0.25rem;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.48rem;

  font-weight:
    700;

  letter-spacing:
    0.12em;

  color:
    #7b837e;

}


/* ================================================================
   TITLE
================================================================ */

.tags-heading h1 {

  margin:
    0;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    1rem;

  font-weight:
    800;

  line-height:
    1.2;

  letter-spacing:
    0.02em;

  text-transform:
    uppercase;

  color:
    #303936;

}


:global(.dark) .tags-heading h1 {

  color:
    #d6ddd8;

}


/* ================================================================
   STATUS
================================================================ */

.tags-heading__status {

  flex-shrink:
    0;

  padding:
    4px 7px;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.48rem;

  font-weight:
    700;

  letter-spacing:
    0.08em;

  color:
    #63776b;

  border:
    1px solid
    #829187;

  background:
    rgb(99 119 107 / 0.06);

}


/* ================================================================
   TAGS GRID
================================================================ */

.tags-grid {

  display:
    grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap:
    0.75rem;

  margin:
    0;

  padding:
    0;

  list-style:
    none;

}


/* ================================================================
   ITEM
================================================================ */

.tags-item {

  min-width:
    0;

}


/* ================================================================
   LINK
================================================================ */

.tags-link {

  display:
    grid;

  grid-template-columns:
    2rem 1fr auto;

  align-items:
    center;

  gap:
    0.65rem;

  min-height:
    48px;

  padding:
    0.65rem 0.75rem;

  background:
    #ded9cc;

  border:
    2px solid
    #303936;

  box-shadow:
    4px 4px 0
    #303936;

  text-decoration:
    none;

  transition:
    transform 0.12s steps(2),
    box-shadow 0.12s steps(2),
    background 0.12s steps(2);

}


:global(.dark) .tags-link {

  background:
    #151b18;

  border-color:
    #4e5b53;

  box-shadow:
    4px 4px 0
    #4e5b53;

}


/* ================================================================
   HOVER
================================================================ */

.tags-link:hover {

  transform:
    translate(2px, 2px);

  box-shadow:
    2px 2px 0
    #303936;

  background:
    #d3cec1;

}


:global(.dark) .tags-link:hover {

  box-shadow:
    2px 2px 0
    #4e5b53;

  background:
    #1b231f;

}


/* ================================================================
   INDEX
================================================================ */

.tags-index {

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.45rem;

  font-weight:
    700;

  letter-spacing:
    0.04em;

  color:
    #89918c;

}


/* ================================================================
   NAME
================================================================ */

.tags-name {

  min-width:
    0;

  overflow:
    hidden;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.65rem;

  font-weight:
    700;

  line-height:
    1.3;

  letter-spacing:
    0.03em;

  text-transform:
    uppercase;

  text-overflow:
    ellipsis;

  white-space:
    nowrap;

  color:
    #303936;

}


:global(.dark) .tags-name {

  color:
    #d2d8d3;

}


/* ================================================================
   ARROW
================================================================ */

.tags-arrow {

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.55rem;

  font-weight:
    700;

  color:
    #63776b;

  transition:
    transform 0.12s steps(2);

}


.tags-link:hover .tags-arrow {

  transform:
    translateX(3px);

}


/* ================================================================
   FOOTER
================================================================ */

.tags-footer {

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  margin-top:
    1rem;

  padding-top:
    0.6rem;

  border-top:
    1px dashed
    #a1a69f;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.43rem;

  font-weight:
    700;

  letter-spacing:
    0.05em;

  color:
    #7b837e;

}


:global(.dark) .tags-footer {

  border-color:
    #3b453f;

}


/* ================================================================
   TABLET
================================================================ */

@media (max-width: 900px) {

  .tags-grid {

    grid-template-columns:
      repeat(2, minmax(0, 1fr));

  }

}


/* ================================================================
   MOBILE
================================================================ */

@media (max-width: 640px) {

  .tags-section {

    width:
      min(
        calc(100% - 1rem),
        64rem
      );

  }


  .tags-grid {

    grid-template-columns:
      1fr;

    gap:
      0.65rem;

  }


  .tags-heading {

    align-items:
      center;

  }


  .tags-heading h1 {

    font-size:
      0.85rem;

  }


  .tags-heading__status {

    font-size:
      0.42rem;

  }


  .tags-link {

    min-height:
      44px;

  }

}


/* ================================================================
   REDUCED MOTION
================================================================ */

@media (prefers-reduced-motion: reduce) {

  .tags-link,
  .tags-arrow {

    transition:
      none;

  }

}

</style>