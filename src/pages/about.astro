---
import Base from '@layouts/Base.astro';
import { Image } from 'astro:assets';
---

<Base meta_title="About & Portfolio">

  <div class="retro-page">

    <!-- ABOUT ME -->
    <section class="retro-section">

      <div class="retro-terminal-bar">
        <span class="terminal-lights">
          <i></i>
          <i></i>
          <i></i>
        </span>

        <span class="terminal-path">
          ~/about/profile
        </span>

        <span class="terminal-status">
          ● ONLINE
        </span>
      </div>

      <div class="retro-section-content">

        <div class="retro-prompt">
          <span>&gt;</span> cat about.txt
        </div>

        <h1 class="retro-title">
          ABOUT<span>_</span>ME
        </h1>

        <div class="retro-copy">

          <p>
            I am a cybersecurity professional specialized in
            <strong>malware reverse engineering</strong> and
            <strong>DFIR (Digital Forensics & Incident Response)</strong>.
            My work is aligned with the
            <strong>DoD Cyber Workforce Framework (DCWF)</strong> and the
            <strong>NICE Cybersecurity Workforce Framework</strong>.
          </p>

          <p>
            Beyond operational work, I practice with
            <strong>Hack The Box (HTB)</strong> to continuously sharpen my
            cyber combat skills.
          </p>

        </div>

        <div class="retro-image">
          <img
            src="/herobanner.png"
            alt="Cybersecurity hero illustration"
          />
        </div>

      </div>

      <div class="retro-section-footer">
        <span>FILE://ABOUT.TXT</span>
        <span>STATUS: OK</span>
      </div>

    </section>


    <!-- PORTFOLIO -->
    <section class="retro-section portfolio-section">

      <div class="retro-terminal-bar">
        <span class="terminal-lights">
          <i></i>
          <i></i>
          <i></i>
        </span>

        <span class="terminal-path">
          ~/portfolio/skills
        </span>

        <span class="terminal-status">
          ● INDEXED
        </span>
      </div>

      <div class="retro-section-content">

        <div class="retro-prompt">
          <span>&gt;</span> ./list_competencies.sh
        </div>

        <h2 class="retro-title">
          CORE<span>_</span>COMPETENCIES
        </h2>

        <div class="retro-grid">

          <!-- Malware Reverse Engineering -->
          <article class="retro-card">

            <div class="retro-card-index">
              [01] // MALWARE
            </div>

            <figure class="retro-card-image">
              <Image
                class="retro-card-img"
                src="/rem.png"
                alt="Malware Reverse Engineering"
                width={960}
                height={480}
                decoding="async"
                loading="lazy"
              />
            </figure>

            <div class="retro-card-body">

              <h3>
                MALWARE REVERSE ENGINEERING
              </h3>

              <p>
                Analyze complex malware to understand behavior,
                persistence mechanisms, and attack infrastructure.
              </p>

              <ul>
                <li>Static & dynamic analysis (IDA, Ghidra, x64dbg)</li>
                <li>Extract indicators of compromise (IOCs)</li>
                <li>Malware behavior and threat analysis</li>
              </ul>

            </div>

            <div class="retro-card-footer">
              <span>MODULE_01</span>
              <span>READY</span>
            </div>

          </article>


          <!-- DFIR -->
          <article class="retro-card">

            <div class="retro-card-index">
              [02] // FORENSICS
            </div>

            <figure class="retro-card-image">
              <Image
                class="retro-card-img"
                src="/dfir.png"
                alt="Digital Forensics & Incident Response"
                width={960}
                height={480}
                decoding="async"
                loading="lazy"
              />
            </figure>

            <div class="retro-card-body">

              <h3>
                DIGITAL FORENSICS & INCIDENT RESPONSE
              </h3>

              <p>
                Conduct forensic investigations, analyze incidents,
                and provide structured guidance for containment
                and remediation.
              </p>

              <ul>
                <li>Incident investigation and analysis</li>
                <li>Digital evidence collection and chain-of-custody</li>
                <li>Root cause and TTP analysis for actionable defense</li>
              </ul>

            </div>

            <div class="retro-card-footer">
              <span>MODULE_02</span>
              <span>READY</span>
            </div>

          </article>


          <!-- Training -->
          <article class="retro-card">

            <div class="retro-card-index">
              [03] // TRAINING
            </div>

            <figure class="retro-card-image">
              <Image
                class="retro-card-img"
                src="/ccdcoe.jpg"
                alt="NATO cyber exercises"
                width={960}
                height={480}
                decoding="async"
                loading="lazy"
              />
            </figure>

            <div class="retro-card-body">

              <h3>
                CONTINUOUS TRAINING
              </h3>

              <p>
                Regularly practice on Hack The Box and participate
                in cyber exercises to sharpen skills and stay ahead
                of threats.
              </p>

              <ul>
                <li>Hands-on labs and simulations</li>
                <li>Threat research and analysis</li>
                <li>Skill improvement in malware analysis, DFIR, and incident response</li>
              </ul>

            </div>

            <div class="retro-card-footer">
              <span>MODULE_03</span>
              <span>READY</span>
            </div>

          </article>

        </div>

      </div>

      <div class="retro-section-footer">
        <span>3 MODULES LOADED</span>
        <span>SYSTEM READY_</span>
      </div>

    </section>

  </div>

</Base>


<style>

.retro-page {
  --retro-cyan: #00b8d4;
  --retro-orange: #ff7043;
  --retro-yellow: #e5a900;

  --retro-dark: #0b1015;
  --retro-dark-panel: #111820;
  --retro-dark-border: #2b3942;

  --retro-light: #f7f3e8;
  --retro-light-panel: #fffdf6;
  --retro-light-border: #26343a;

  margin: 2rem auto 5rem;
}


/* ================================================================
   TERMINAL WINDOW
================================================================ */

.retro-section {
  position: relative;

  margin-bottom: 4rem;

  overflow: hidden;

  border: 2px solid var(--retro-light-border);

  background:
    repeating-linear-gradient(
      to bottom,
      rgb(38 52 58 / 0.035) 0,
      rgb(38 52 58 / 0.035) 1px,
      transparent 1px,
      transparent 4px
    ),
    var(--retro-light-panel);

  box-shadow:
    8px 8px 0 var(--retro-orange);

  isolation: isolate;
}


/* CRT scanlines */

.retro-section::after {
  content: '';

  position: absolute;
  inset: 0;

  pointer-events: none;

  background:
    repeating-linear-gradient(
      to bottom,
      rgb(0 0 0 / 0.025) 0,
      rgb(0 0 0 / 0.025) 1px,
      transparent 1px,
      transparent 4px
    );

  z-index: 20;
}


/* ================================================================
   TERMINAL HEADER
================================================================ */

.retro-terminal-bar {
  position: relative;
  z-index: 2;

  min-height: 44px;

  display: flex;
  align-items: center;

  gap: 1rem;

  padding: 0 1rem;

  background: #ebe6d9;

  border-bottom: 2px solid var(--retro-light-border);

  color: #26343a;

  font-family: 'JetBrains Mono', monospace;

  font-size: 0.58rem;
  font-weight: 700;

  letter-spacing: 0.08em;

  text-transform: uppercase;
}


.terminal-lights {
  display: flex;
  gap: 6px;
}


.terminal-lights i {
  width: 8px;
  height: 8px;

  display: block;

  border: 1px solid #26343a;

  box-shadow:
    1px 1px 0 rgb(0 0 0 / 0.3);
}


.terminal-lights i:nth-child(1) {
  background: var(--retro-orange);
}


.terminal-lights i:nth-child(2) {
  background: var(--retro-yellow);
}


.terminal-lights i:nth-child(3) {
  background: var(--retro-cyan);
}


.terminal-path {
  opacity: 0.75;
}


.terminal-status {
  margin-left: auto;

  color: #16889a;

  font-size: 0.48rem;
}


/* ================================================================
   CONTENT
================================================================ */

.retro-section-content {
  position: relative;
  z-index: 2;

  padding: 3rem;
}


/* ================================================================
   PROMPT
================================================================ */

.retro-prompt {
  margin-bottom: 1rem;

  color: #68777c;

  font-family: 'JetBrains Mono', monospace;

  font-size: 0.62rem;
  font-weight: 700;

  letter-spacing: 0.06em;
}


.retro-prompt span {
  color: var(--retro-cyan);

  margin-right: 0.45rem;

  font-weight: 900;
}


/* ================================================================
   TITLES
================================================================ */

.retro-title {
  margin: 0 0 1.8rem;

  color: #172127;

  font-family: 'Press Start 2P', monospace;

  font-size: clamp(1.35rem, 3vw, 2rem);

  font-weight: 400;

  line-height: 1.55;

  letter-spacing: 0.02em;

  text-shadow:
    3px 3px 0 rgb(255 112 67 / 0.35);
}


.retro-title span {
  color: var(--retro-cyan);

  animation:
    retro-cursor 1s steps(1) infinite;
}


@keyframes retro-cursor {
  0%,
  49% {
    opacity: 1;
  }

  50%,
  100% {
    opacity: 0;
  }
}


/* ================================================================
   TEXT
================================================================ */

.retro-copy {
  max-width: 52rem;

  color: #39484e;

  font-family: 'JetBrains Mono', monospace;

  font-size: 0.82rem;

  line-height: 1.85;
}


.retro-copy p {
  margin-bottom: 1rem;
}


.retro-copy strong {
  color: #087f91;

  font-weight: 800;
}


/* ================================================================
   HERO IMAGE
================================================================ */

.retro-image {
  position: relative;

  margin-top: 2rem;

  padding: 4px;

  background:
    linear-gradient(
      135deg,
      var(--retro-orange),
      var(--retro-cyan)
    );

  clip-path: polygon(
    0 10px,
    5px 10px,
    5px 5px,
    10px 5px,
    10px 0,
    calc(100% - 10px) 0,
    calc(100% - 10px) 5px,
    calc(100% - 5px) 5px,
    calc(100% - 5px) 10px,
    100% 10px,
    100% calc(100% - 10px),
    calc(100% - 5px) calc(100% - 10px),
    calc(100% - 5px) calc(100% - 5px),
    calc(100% - 10px) calc(100% - 5px),
    calc(100% - 10px) 100%,
    10px 100%,
    10px calc(100% - 5px),
    5px calc(100% - 5px),
    5px calc(100% - 10px),
    0 calc(100% - 10px)
  );

  box-shadow:
    6px 6px 0 rgb(38 52 58 / 0.25);
}


.retro-image img {
  display: block;

  width: 100%;

  max-height: 420px;

  object-fit: cover;

  background: var(--retro-light-panel);

  filter:
    saturate(0.9)
    contrast(1.05);
}


/* ================================================================
   GRID
================================================================ */

.retro-grid {
  display: grid;

  grid-template-columns:
    repeat(3, minmax(0, 1fr));

  gap: 1rem;
}


/* ================================================================
   CARDS
================================================================ */

.retro-card {
  position: relative;

  display: flex;
  flex-direction: column;

  min-width: 0;

  background: #fffdf6;

  border: 2px solid var(--retro-light-border);

  box-shadow:
    5px 5px 0 rgb(38 52 58 / 0.2);

  transition:
    transform 0.1s steps(2),
    box-shadow 0.1s steps(2),
    border-color 0.1s steps(2);
}


.retro-card:hover {
  transform:
    translate(-3px, -3px);

  border-color:
    var(--retro-cyan);

  box-shadow:
    8px 8px 0 var(--retro-orange);
}


/* ================================================================
   CARD INDEX
================================================================ */

.retro-card-index {
  padding: 0.65rem 0.75rem;

  background: #ebe6d9;

  border-bottom: 2px solid var(--retro-light-border);

  color: #69777b;

  font-family: 'JetBrains Mono', monospace;

  font-size: 0.48rem;
  font-weight: 800;

  letter-spacing: 0.08em;
}


/* ================================================================
   CARD IMAGE
================================================================ */

.retro-card-image {
  height: 170px;

  margin: 0;

  overflow: hidden;

  background: #111820;

  border-bottom: 2px solid var(--retro-light-border);
}


.retro-card-img {
  width: 100%;
  height: 100%;

  object-fit: cover;

  display: block;

  transition:
    transform 0.15s steps(3),
    filter 0.15s steps(2);

  filter:
    saturate(0.85)
    contrast(1.08);
}


.retro-card:hover .retro-card-img {
  transform: scale(1.06);

  filter:
    saturate(1.1)
    contrast(1.1);
}


/* ================================================================
   CARD BODY
================================================================ */

.retro-card-body {
  flex: 1;

  padding: 1.25rem;
}


.retro-card-body h3 {
  margin: 0 0 0.8rem;

  color: #18242a;

  font-family: 'Press Start 2P', monospace;

  font-size: 0.7rem;

  font-weight: 400;

  line-height: 1.7;

  text-transform: uppercase;
}


.retro-card-body p {
  margin-bottom: 1rem;

  color: #526166;

  font-family: 'JetBrains Mono', monospace;

  font-size: 0.72rem;

  line-height: 1.7;
}


.retro-card-body ul {
  margin: 0;

  padding: 0;

  list-style: none;

  color: #35454b;

  font-family: 'JetBrains Mono', monospace;

  font-size: 0.65rem;

  line-height: 1.65;
}


.retro-card-body li {
  position: relative;

  padding-left: 1rem;

  margin-bottom: 0.4rem;
}


.retro-card-body li::before {
  content: '>';

  position: absolute;
  left: 0;

  color: var(--retro-cyan);

  font-weight: 900;
}


/* ================================================================
   CARD FOOTER
================================================================ */

.retro-card-footer {
  display: flex;

  justify-content: space-between;

  padding: 0.6rem 0.75rem;

  background: #ebe6d9;

  border-top: 2px solid var(--retro-light-border);

  color: #68777c;

  font-family: 'JetBrains Mono', monospace;

  font-size: 0.45rem;

  font-weight: 800;

  letter-spacing: 0.08em;
}


.retro-card-footer span:last-child {
  color: #16889a;
}


/* ================================================================
   SECTION FOOTER
================================================================ */

.retro-section-footer {
  position: relative;
  z-index: 2;

  min-height: 38px;

  display: flex;

  align-items: center;

  justify-content: space-between;

  padding: 0 1rem;

  background: #ebe6d9;

  border-top: 2px solid var(--retro-light-border);

  color: #68777c;

  font-family: 'JetBrains Mono', monospace;

  font-size: 0.48rem;

  font-weight: 700;

  letter-spacing: 0.08em;
}


.retro-section-footer span:last-child {
  color: #16889a;
}


/* ================================================================
   DARK MODE
================================================================ */

:global(.dark) .retro-section {
  background:
    repeating-linear-gradient(
      to bottom,
      rgb(255 255 255 / 0.018) 0,
      rgb(255 255 255 / 0.018) 1px,
      transparent 1px,
      transparent 4px
    ),
    var(--retro-dark);

  border-color: var(--retro-dark-border);

  box-shadow:
    8px 8px 0 var(--retro-orange);
}


:global(.dark) .retro-terminal-bar,
:global(.dark) .retro-section-footer,
:global(.dark) .retro-card-index,
:global(.dark) .retro-card-footer {
  background: #10171d;

  border-color: var(--retro-dark-border);

  color: #66777d;
}


:global(.dark) .retro-title {
  color: #ffffff;
}


:global(.dark) .retro-copy {
  color: #a5b1b5;
}


:global(.dark) .retro-copy strong {
  color: var(--retro-cyan);
}


:global(.dark) .retro-card {
  background: var(--retro-dark-panel);

  border-color: var(--retro-dark-border);
}


:global(.dark) .retro-card-body h3 {
  color: #ffffff;
}


:global(.dark) .retro-card-body p {
  color: #9aa8ad;
}


:global(.dark) .retro-card-body ul {
  color: #b3bec1;
}


:global(.dark) .retro-card-index,
:global(.dark) .retro-card-footer,
:global(.dark) .retro-section-footer {
  color: #718087;
}


:global(.dark) .retro-terminal-bar {
  color: #9aa8ad;
}


/* ================================================================
   MOBILE
================================================================ */

@media (max-width: 900px) {

  .retro-grid {
    grid-template-columns: 1fr;
  }

}


@media (max-width: 767px) {

  .retro-page {
    margin-top: 1rem;
  }

  .retro-section {
    margin-bottom: 2.5rem;

    box-shadow:
      5px 5px 0 var(--retro-orange);
  }

  .retro-terminal-bar {
    min-height: 40px;

    padding: 0 0.7rem;

    font-size: 0.46rem;
  }

  .terminal-status {
    font-size: 0.4rem;
  }

  .retro-section-content {
    padding: 1.5rem 1rem;
  }

  .retro-title {
    font-size: 1.15rem;

    line-height: 1.6;
  }

  .retro-copy {
    font-size: 0.72rem;

    line-height: 1.8;
  }

  .retro-card-image {
    height: 190px;
  }

  .retro-card-body {
    padding: 1rem;
  }

  .retro-card-body h3 {
    font-size: 0.62rem;
  }

  .retro-section-footer {
    min-height: 34px;

    padding: 0 0.7rem;

    font-size: 0.4rem;
  }

}


/* ================================================================
   REDUCED MOTION
================================================================ */

@media (prefers-reduced-motion: reduce) {

  .retro-title span {
    animation: none;
  }

  .retro-card,
  .retro-card-img {
    transition: none;
  }

}

</style>