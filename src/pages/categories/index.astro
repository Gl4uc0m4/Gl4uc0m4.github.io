---
import Base from '@layouts/Base.astro';
import CategoryIcon from '@icons/CategoryIcon.astro';
import { getTaxonomy } from '@utils/getAllTags';

const allCategories = await getTaxonomy('blog', 'categories');

const uniqueCategories = [...new Set(allCategories.map((item) => item.slug))]
  .map((slug) => allCategories.find((cat) => cat.slug === slug))
  .filter(Boolean);
---

<Base>
  <section class="categories-section">

    <!-- CABECERA -->

    <div class="categories-heading">

      <div class="categories-heading__left">

        <span class="categories-kicker">
          SYSTEM::CATEGORIES
        </span>

        <h1>
          Categories
        </h1>

      </div>

      <span class="categories-heading__status">
        [ INDEX ]
      </span>

    </div>


    <!-- CATEGORÍAS -->

    <ul class="categories-grid">

      {
        uniqueCategories.map((category, index) => (

          <li class="category-card">

            <a
              href={`/categories/${category?.slug}`}
              title={`View posts in category: ${category?.name}`}
              class="category-link"
            >

              <span class="category-index">
                {String(index + 1).padStart(2, '0')}
              </span>

              <span class="category-icon">
                <CategoryIcon />
              </span>

              <span class="category-content">

                <span class="category-label">
                  CATEGORY
                </span>

                <span class="category-name">
                  {category?.name}
                </span>

              </span>

              <span class="category-arrow">
                &gt;&gt;
              </span>

            </a>

          </li>

        ))
      }

    </ul>


    <!-- FOOTER -->

    <div class="categories-footer">

      <span>
        TOTAL:: {uniqueCategories.length}
      </span>

      <span>
        STATUS:: READY
      </span>

    </div>

  </section>
</Base>


<style>

/* ================================================================
   SECTION
================================================================ */

.categories-section {

  position:
    relative;

  width:
    min(
      calc(100% - 2rem),
      64rem
    );

  margin-inline:
    auto;

  padding-bottom:
    3rem;

}


/* ================================================================
   GRID DE FONDO
================================================================ */

.categories-section::before {

  content:
    '';

  position:
    absolute;

  inset:
    0;

  z-index:
    -1;

  pointer-events:
    none;

  background-image:
    linear-gradient(
      to right,
      rgb(48 57 54 / 0.035) 1px,
      transparent 1px
    ),
    linear-gradient(
      to bottom,
      rgb(48 57 54 / 0.035) 1px,
      transparent 1px
    );

  background-size:
    20px 20px;

}


:global(.dark) .categories-section::before {

  background-image:
    linear-gradient(
      to right,
      rgb(255 255 255 / 0.018) 1px,
      transparent 1px
    ),
    linear-gradient(
      to bottom,
      rgb(255 255 255 / 0.018) 1px,
      transparent 1px
    );

}


/* ================================================================
   HEADING
================================================================ */

.categories-heading {

  display:
    flex;

  align-items:
    flex-end;

  justify-content:
    space-between;

  gap:
    1rem;

  margin-bottom:
    1rem;

  padding-bottom:
    0.7rem;

  border-bottom:
    2px solid
    #303936;

}


:global(.dark) .categories-heading {

  border-color:
    #4b5951;

}


/* ================================================================
   KICKER
================================================================ */

.categories-kicker {

  display:
    block;

  margin-bottom:
    0.25rem;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.48rem;

  font-weight:
    700;

  letter-spacing:
    0.12em;

  color:
    #7b837e;

}


/* ================================================================
   TITLE
================================================================ */

.categories-heading h1 {

  margin:
    0;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    1rem;

  font-weight:
    800;

  line-height:
    1.2;

  letter-spacing:
    0.02em;

  text-transform:
    uppercase;

  color:
    #303936;

}


:global(.dark) .categories-heading h1 {

  color:
    #d6ddd8;

}


/* ================================================================
   STATUS
================================================================ */

.categories-heading__status {

  flex-shrink:
    0;

  padding:
    4px 7px;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.48rem;

  font-weight:
    700;

  letter-spacing:
    0.08em;

  color:
    #63776b;

  border:
    1px solid
    #829187;

  background:
    rgb(99 119 107 / 0.06);

}


/* ================================================================
   GRID
================================================================ */

.categories-grid {

  display:
    grid;

  grid-template-columns:
    repeat(2, minmax(0, 1fr));

  gap:
    0.9rem;

  margin:
    0;

  padding:
    0;

  list-style:
    none;

}


/* ================================================================
   CARD
================================================================ */

.category-card {

  min-width:
    0;

}


/* ================================================================
   LINK
================================================================ */

.category-link {

  display:
    grid;

  grid-template-columns:
    2rem 1.5rem 1fr auto;

  align-items:
    center;

  gap:
    0.7rem;

  min-height:
    72px;

  padding:
    0.75rem;

  background:
    #ded9cc;

  border:
    2px solid
    #303936;

  box-shadow:
    4px 4px 0
    #303936;

  text-decoration:
    none;

  transition:
    transform 0.12s steps(2),
    box-shadow 0.12s steps(2),
    background 0.12s steps(2);

}


:global(.dark) .category-link {

  background:
    #151b18;

  border-color:
    #4e5b53;

  box-shadow:
    4px 4px 0
    #4e5b53;

}


/* ================================================================
   HOVER
================================================================ */

.category-link:hover {

  transform:
    translate(2px, 2px);

  box-shadow:
    2px 2px 0
    #303936;

  background:
    #d3cec1;

}


:global(.dark) .category-link:hover {

  box-shadow:
    2px 2px 0
    #4e5b53;

  background:
    #1b231f;

}


/* ================================================================
   INDEX
================================================================ */

.category-index {

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.45rem;

  font-weight:
    700;

  color:
    #89918c;

}


/* ================================================================
   ICON
================================================================ */

.category-icon {

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  width:
    1.35rem;

  height:
    1.35rem;

  color:
    #63776b;

  border:
    1px solid
    #829187;

}


.category-icon :global(svg) {

  width:
    0.75rem;

  height:
    0.75rem;

}


/* ================================================================
   CONTENT
================================================================ */

.category-content {

  display:
    flex;

  flex-direction:
    column;

  min-width:
    0;

}


/* ================================================================
   LABEL
================================================================ */

.category-label {

  margin-bottom:
    0.15rem;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.42rem;

  font-weight:
    700;

  letter-spacing:
    0.08em;

  color:
    #89918c;

}


/* ================================================================
   NAME
================================================================ */

.category-name {

  overflow:
    hidden;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.72rem;

  font-weight:
    700;

  letter-spacing:
    0.03em;

  text-transform:
    uppercase;

  text-overflow:
    ellipsis;

  white-space:
    nowrap;

  color:
    #303936;

}


:global(.dark) .category-name {

  color:
    #d2d8d3;

}


/* ================================================================
   ARROW
================================================================ */

.category-arrow {

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.55rem;

  font-weight:
    700;

  color:
    #63776b;

  transition:
    transform 0.12s steps(2);

}


.category-link:hover .category-arrow {

  transform:
    translateX(3px);

}


/* ================================================================
   FOOTER
================================================================ */

.categories-footer {

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  margin-top:
    1rem;

  padding-top:
    0.6rem;

  border-top:
    1px dashed
    #a1a69f;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.43rem;

  font-weight:
    700;

  letter-spacing:
    0.05em;

  color:
    #7b837e;

}


:global(.dark) .categories-footer {

  border-color:
    #3b453f;

}


/* ================================================================
   TABLET
================================================================ */

@media (max-width: 700px) {

  .categories-grid {

    grid-template-columns:
      1fr;

  }

}


/* ================================================================
   MOBILE
================================================================ */

@media (max-width: 640px) {

  .categories-section {

    width:
      min(
        calc(100% - 1rem),
        64rem
      );

  }


  .categories-heading {

    align-items:
      center;

  }


  .categories-heading h1 {

    font-size:
      0.85rem;

  }


  .categories-heading__status {

    font-size:
      0.42rem;

  }


  .category-link {

    grid-template-columns:
      1.5rem 1.35rem 1fr auto;

    gap:
      0.55rem;

    min-height:
      64px;

  }

}


/* ================================================================
   REDUCED MOTION
================================================================ */

@media (prefers-reduced-motion: reduce) {

  .category-link,
  .category-arrow {

    transition:
      none;

  }

}

</style>