---
import Base from '@layouts/Base.astro';
import type { CollectionEntry } from 'astro:content';
import FormattedDate from '@components/FormattedDate.astro';
import { Image } from 'astro:assets';
import config from '@config/config.json';
import { slugify } from '@utils/slug';

type Props = CollectionEntry<'blog'>['data'];

const {
  title,
  description,
  pubDate,
  heroImage,
  categories,
  tags,
} = Astro.props;
---

<Base
  meta_title={title}
  description={description}
  image={heroImage}
  blogpost
>
  <article class="pixel-post">

    <!-- =========================================================
         HERO
    ========================================================== -->

    {
      heroImage && (
        <figure class="hero-console">

          <div class="hero-console__topbar">
            <div class="hero-console__lights" aria-hidden="true">
              <span class="console-light console-light--red" />
              <span class="console-light console-light--yellow" />
              <span class="console-light console-light--green" />
            </div>

            <span class="hero-console__label">
              MALWARE_ANALYSIS // VISUAL_EVIDENCE
            </span>

            <span class="hero-console__status">
              <span class="status-dot" />
              ONLINE
            </span>
          </div>

          <div class="hero-console__screen">
            <div class="hero-console__image">

              <Image
                src={heroImage}
                alt={title}
                width={1600}
                height={900}
                decoding="async"
                loading="eager"
                class="hero-image"
              />

              <div class="crt-lines" aria-hidden="true" />
              <div class="crt-vignette" aria-hidden="true" />

              <span class="scan-corner scan-corner--tl" />
              <span class="scan-corner scan-corner--tr" />
              <span class="scan-corner scan-corner--bl" />
              <span class="scan-corner scan-corner--br" />

              <div class="hero-hud hero-hud--top">
                <span>IMG::ANALYSIS</span>
                <span>0x01</span>
              </div>

              <div class="hero-hud hero-hud--bottom">
                <span>FRAME::ACTIVE</span>
                <span>██████</span>
              </div>

            </div>
          </div>

          <figcaption class="hero-console__bottom">
            <span>REVERSE_ENGINEERING</span>
            <span>SYS::ONLINE</span>
          </figcaption>

        </figure>
      )
    }


    <!-- =========================================================
         HEADER
    ========================================================== -->

    <header class="post-header">

      {
        categories?.slice(0, 1).map((category) => (
          <a
            href={`/categories/${slugify(category)}`}
            class="category-cartridge"
          >
            <span aria-hidden="true">▶</span>
            {category}
          </a>
        ))
      }

      <div class="title-block">

        <h1 class="pixel-title">
          {title}
          <span class="pixel-cursor" aria-hidden="true">_</span>
        </h1>

        {
          description && (
            <p class="post-description">
              {description}
            </p>
          )
        }

      </div>


      <!-- =======================================================
           META
      ======================================================== -->

      <div class="stat-console">

        <div class="stat-console__item">

          <span class="stat-console__icon">
            ID
          </span>

          <div class="stat-console__content">
            <small>AUTHOR</small>
            <strong>{config.author.name}</strong>
          </div>

          <Image
            alt=""
            class="stat-console__avatar"
            width={40}
            height={40}
            src={config.author.avatar}
            decoding="async"
            loading="lazy"
          />

        </div>


        <div class="stat-console__item">

          <span class="stat-console__icon stat-console__icon--cyan">
            DT
          </span>

          <div class="stat-console__content">
            <small>PUBLISHED</small>
            <strong>
              <FormattedDate date={pubDate} />
            </strong>
          </div>

        </div>


        <div class="stat-console__item">

          <span class="stat-console__icon stat-console__icon--yellow">
            OP
          </span>

          <div class="stat-console__content">
            <small>OPERATION</small>
            <strong>REVERSE_ENGINEERING</strong>
          </div>

        </div>

      </div>

    </header>


    <!-- =========================================================
         ARTICLE
    ========================================================== -->

    <div class="article-shell">

      <div class="pixel-prose prose prose-lg max-w-none">
        <slot />
      </div>

    </div>


    <!-- =========================================================
         TAGS
    ========================================================== -->

    <footer class="post-footer">

      <div class="post-footer__header">
        <span>INDEX::TAGS</span>
        <span>#{tags?.length ?? 0}</span>
      </div>

      <div class="post-tags">
        {
          tags?.map((tag) => (
            <a
              href={`/tags/${slugify(tag)}`}
              class="pixel-tag"
            >
              <span>#</span>
              {tag}
            </a>
          ))
        }
      </div>

      <div class="post-footer__status">
        <span class="status-dot" />
        END_OF_FILE
      </div>

    </footer>

  </article>
</Base>


<style>

/* ================================================================
   POST / GLOBAL
================================================================ */

.pixel-post {

  width:
    min(100% - 2rem, 90rem);

  margin-inline:
    auto;

  box-sizing:
    border-box;

  --pixel-shadow:
    6px 6px 0 rgb(var(--px-border));

  color:
    #303936;
}


/* ================================================================
   PAGE BACKGROUND
   LIGHT MODE
   AMARILLO / BEIGE APAGADO + GRID
================================================================ */

:global(html) {

  background-color:
    #f1edda;

  background-image:
    linear-gradient(
      rgba(74, 72, 55, 0.075) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(74, 72, 55, 0.075) 1px,
      transparent 1px
    );

  background-size:
    24px 24px;
}


:global(body) {

  min-height:
    100vh;

  background-color:
    #f1edda;

  background-image:
    linear-gradient(
      rgba(74, 72, 55, 0.075) 1px,
      transparent 1px
    ),
    linear-gradient(
      90deg,
      rgba(74, 72, 55, 0.075) 1px,
      transparent 1px
    );

  background-size:
    24px 24px;

  color:
    #303936;
}


/* ================================================================
   DARK PAGE
   SE QUEDA COMO ESTABA
================================================================ */

:global(.dark),
:global(.dark body) {

  background-color:
    #0d1210;

  background-image:
    none;

  color:
    #d5ddd7;
}


/* ================================================================
   HERO
================================================================ */

.hero-console {

  position:
    relative;

  width:
    100%;

  margin:
    0 0 5rem;

  padding:
    0;

  box-sizing:
    border-box;

  background:
    rgb(var(--px-panel));

  border:
    3px solid rgb(var(--px-border));

  box-shadow:
    9px 9px 0 rgb(var(--px-border));

  overflow:
    hidden;

  transition:
    transform 0.12s steps(2),
    box-shadow 0.12s steps(2);
}

.hero-console:hover {

  transform:
    translate(-3px, -3px);

  box-shadow:
    12px 12px 0 rgb(var(--px-border));
}


/* ================================================================
   HERO TOP BAR
================================================================ */

.hero-console__topbar {

  min-height:
    44px;

  display:
    grid;

  grid-template-columns:
    1fr auto 1fr;

  align-items:
    center;

  gap:
    1rem;

  padding:
    0 16px;

  box-sizing:
    border-box;

  background:
    rgb(var(--px-panel-raised));

  border-bottom:
    2px solid rgb(var(--px-border));

  color:
    rgb(var(--color-text-body));

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.55rem;

  font-weight:
    700;

  letter-spacing:
    0.1em;

  text-transform:
    uppercase;
}

.hero-console__lights {

  display:
    flex;

  gap:
    6px;
}

.console-light {

  width:
    9px;

  height:
    9px;

  border:
    1px solid rgb(var(--px-border));

  box-shadow:
    1px 1px 0 rgb(var(--px-border));
}

.console-light--red {

  background:
    rgb(var(--px-orange));
}

.console-light--yellow {

  background:
    rgb(var(--px-yellow));
}

.console-light--green {

  background:
    rgb(var(--px-cyan));
}

.hero-console__label {

  text-align:
    center;
}

.hero-console__status {

  display:
    flex;

  align-items:
    center;

  justify-content:
    flex-end;

  gap:
    7px;

  color:
    rgb(var(--px-cyan));
}

.status-dot {

  width:
    7px;

  height:
    7px;

  display:
    inline-block;

  flex-shrink:
    0;

  background:
    currentColor;

  box-shadow:
    2px 2px 0 rgb(var(--px-border));
}


/* ================================================================
   HERO SCREEN
================================================================ */

.hero-console__screen {

  padding:
    14px;

  background:
    rgb(var(--px-panel));
}

.hero-console__image {

  position:
    relative;

  width:
    100%;

  overflow:
    hidden;

  background:
    #050708;

  border:
    3px solid rgb(var(--px-border));

  box-shadow:
    inset 0 0 0 1px rgb(255 255 255 / 0.04);
}

.hero-image {

  display:
    block;

  width:
    100%;

  height:
    auto;

  max-height:
    72vh;

  object-fit:
    contain;

  image-rendering:
    auto;

  filter:
    saturate(0.95)
    contrast(1.03);
}


/* ================================================================
   CRT
================================================================ */

.crt-lines {

  position:
    absolute;

  inset:
    0;

  pointer-events:
    none;

  background:
    rgb(0 0 0 / 0.06);

  opacity:
    0.35;

  mix-blend-mode:
    multiply;
}

:global(.dark) .crt-lines {

  background:
    rgb(255 255 255 / 0.025);

  opacity:
    0.45;

  mix-blend-mode:
    screen;
}

.crt-vignette {

  position:
    absolute;

  inset:
    0;

  pointer-events:
    none;

  box-shadow:
    inset 0 0 90px rgb(0 0 0 / 0.24);
}


/* ================================================================
   SCREEN CORNERS
================================================================ */

.scan-corner {

  position:
    absolute;

  width:
    24px;

  height:
    24px;

  border-color:
    rgb(var(--px-cyan));

  border-style:
    solid;

  opacity:
    0.9;
}

.scan-corner--tl {

  top:
    14px;

  left:
    14px;

  border-width:
    3px 0 0 3px;
}

.scan-corner--tr {

  top:
    14px;

  right:
    14px;

  border-width:
    3px 3px 0 0;
}

.scan-corner--bl {

  bottom:
    14px;

  left:
    14px;

  border-width:
    0 0 3px 3px;
}

.scan-corner--br {

  right:
    14px;

  bottom:
    14px;

  border-width:
    0 3px 3px 0;
}


/* ================================================================
   HERO HUD
================================================================ */

.hero-hud {

  position:
    absolute;

  z-index:
    3;

  display:
    flex;

  align-items:
    center;

  gap:
    12px;

  padding:
    6px 9px;

  background:
    rgb(5 7 8 / 0.82);

  color:
    rgb(var(--px-cyan));

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.5rem;

  font-weight:
    700;

  letter-spacing:
    0.1em;
}

.hero-hud--top {

  top:
    16px;

  left:
    16px;
}

.hero-hud--bottom {

  right:
    16px;

  bottom:
    16px;

  color:
    rgb(var(--px-yellow));
}


/* ================================================================
   HERO BOTTOM
================================================================ */

.hero-console__bottom {

  min-height:
    38px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    space-between;

  padding:
    0 16px;

  background:
    rgb(var(--px-panel-raised));

  border-top:
    2px solid rgb(var(--px-border));

  color:
    rgb(var(--color-text-body));

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.5rem;

  font-weight:
    700;

  letter-spacing:
    0.1em;
}

.hero-console__bottom span:last-child {

  color:
    rgb(var(--px-cyan));
}


/* ================================================================
   POST HEADER
================================================================ */

.post-header {

  margin-bottom:
    6rem;

  text-align:
    center;
}


/* ================================================================
   CATEGORY
================================================================ */

.category-cartridge {

  display:
    inline-flex;

  align-items:
    center;

  gap:
    9px;

  margin-bottom:
    1.5rem;

  padding:
    8px 12px;

  background:
    rgb(var(--px-orange));

  border:
    2px solid rgb(var(--px-orange));

  color:
    #080b10;

  box-shadow:
    4px 4px 0 rgb(var(--px-border));

  font-family:
    'Press Start 2P',
    monospace;

  font-size:
    0.45rem;

  line-height:
    1.5;

  text-decoration:
    none;

  text-transform:
    uppercase;

  transition:
    transform 0.1s steps(2),
    box-shadow 0.1s steps(2);
}

.category-cartridge:hover {

  transform:
    translate(-2px, -2px);

  box-shadow:
    6px 6px 0 rgb(var(--px-border));

  background:
    rgb(var(--px-yellow));

  border-color:
    rgb(var(--px-yellow));
}


/* ================================================================
   TITLE
================================================================ */

.title-block {

  width:
    100%;

  margin-inline:
    auto;

  text-align:
    center;
}

.pixel-title {

  max-width:
    64rem;

  margin:
    0 auto;

  color:
    rgb(var(--color-text-heading));

  font-family:
    'Press Start 2P',
    monospace;

  font-size:
    clamp(
      1.05rem,
      2vw,
      1.8rem
    );

  font-weight:
    400;

  line-height:
    1.65;

  letter-spacing:
    -0.015em;

  text-transform:
    uppercase;

  text-wrap:
    balance;

  text-shadow:
    3px 3px 0 rgb(var(--px-border));
}


/* ================================================================
   DESCRIPTION
================================================================ */

.post-description {

  max-width:
    58rem;

  margin:
    1.25rem auto 0;

  color:
    rgb(var(--color-text-body));

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.78rem;

  line-height:
    1.8;

  text-wrap:
    pretty;
}


/* ================================================================
   CURSOR
================================================================ */

.pixel-cursor {

  display:
    inline-block;

  margin-left:
    0.12em;

  color:
    rgb(var(--px-orange));

  animation:
    pixel-blink 1s steps(1) infinite;
}

@keyframes pixel-blink {

  0%,
  49% {
    opacity:
      1;
  }

  50%,
  100% {
    opacity:
      0;
  }
}


/* ================================================================
   META CONSOLE
================================================================ */

.stat-console {

  margin-top:
    2.5rem;

  display:
    grid;

  grid-template-columns:
    repeat(3, 1fr);

  background:
    rgb(var(--px-panel));

  border:
    2px solid rgb(var(--px-border));

  box-shadow:
    4px 4px 0 rgb(var(--px-border));

  text-align:
    left;
}

.stat-console__item {

  min-height:
    70px;

  display:
    flex;

  align-items:
    center;

  gap:
    0.8rem;

  padding:
    0.9rem 1.1rem;

  box-sizing:
    border-box;
}

.stat-console__item + .stat-console__item {

  border-left:
    1px dashed rgb(var(--px-border));
}

.stat-console__content {

  min-width:
    0;

  display:
    flex;

  flex-direction:
    column;

  align-items:
    flex-start;

  gap:
    5px;
}

.stat-console__item small {

  color:
    rgb(var(--px-cyan));

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.45rem;

  font-weight:
    700;

  letter-spacing:
    0.1em;
}

.stat-console__item strong {

  min-width:
    0;

  overflow:
    hidden;

  color:
    rgb(var(--color-text-body));

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.65rem;

  font-weight:
    600;

  text-overflow:
    ellipsis;

  white-space:
    nowrap;
}

.stat-console__icon {

  width:
    30px;

  height:
    30px;

  display:
    flex;

  align-items:
    center;

  justify-content:
    center;

  flex-shrink:
    0;

  background:
    rgb(var(--px-orange));

  border:
    2px solid rgb(var(--px-border));

  color:
    #080b10;

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.45rem;

  font-weight:
    900;

  box-shadow:
    2px 2px 0 rgb(var(--px-border));
}

.stat-console__icon--cyan {

  background:
    rgb(var(--px-cyan));
}

.stat-console__icon--yellow {

  background:
    rgb(var(--px-yellow));
}

.stat-console__avatar {

  width:
    26px;

  height:
    26px;

  margin-left:
    auto;

  flex-shrink:
    0;

  object-fit:
    cover;

  border:
    2px solid rgb(var(--px-border));

  image-rendering:
    pixelated;
}


/* ================================================================
   ARTICLE
================================================================ */

.article-shell {

  width:
    min(100%, 76rem);

  margin-inline:
    auto;

  box-sizing:
    border-box;
}

.pixel-prose {

  width:
    100%;

  max-width:
    none;

  margin-inline:
    auto;

  box-sizing:
    border-box;
}


/* ================================================================
   BODY TEXT
================================================================ */

.pixel-prose :global(p) {

  max-width:
    95ch;

  margin-top:
    1.8rem;

  margin-bottom:
    1.8rem;

  color:
    rgb(var(--color-text-body));

  font-size:
    1.05rem;

  line-height:
    1.9;
}

@media (min-width: 768px) {

  .pixel-prose :global(p) {

    font-size:
      1.08rem;

    line-height:
      1.9;
  }
}


/* ================================================================
   LISTS
================================================================ */

.pixel-prose :global(ul),
.pixel-prose :global(ol) {

  max-width:
    95ch;

  margin-top:
    1.75rem;

  margin-bottom:
    2rem;

  padding-left:
    1.6rem;

  line-height:
    1.9;
}

.pixel-prose :global(li) {

  margin-top:
    0.7rem;

  margin-bottom:
    0.7rem;
}


/* ================================================================
   HEADINGS
================================================================ */

.pixel-prose :global(h2) {

  position:
    relative;

  margin-top:
    5rem;

  margin-bottom:
    2rem;

  padding:
    0.5rem 0 1rem 1.25rem;

  color:
    rgb(var(--color-text-heading));

  border-bottom:
    2px solid rgb(var(--px-border));
}

.pixel-prose :global(h3) {

  position:
    relative;

  margin-top:
    3.5rem;

  margin-bottom:
    1.5rem;

  padding-left:
    1rem;

  color:
    rgb(var(--color-text-heading));
}

.pixel-prose :global(h4) {

  margin-top:
    3rem;

  margin-bottom:
    1.25rem;

  color:
    rgb(var(--color-text-heading));
}


/* ================================================================
   HEADING PIXELS
================================================================ */

.pixel-prose :global(h2)::before,
.pixel-prose :global(h3)::before {

  content:
    '';

  position:
    absolute;

  left:
    0;

  top:
    0.2em;

  width:
    5px;

  height:
    calc(100% - 0.4em);

  background:
    rgb(var(--px-cyan));

  box-shadow:
    3px 0 0 rgb(var(--px-orange) / 0.45);
}

.pixel-prose :global(h2)::after {

  content:
    '//';

  margin-left:
    0.6rem;

  color:
    rgb(var(--px-orange));

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.65em;
}

.pixel-prose :global(h3)::after {

  content:
    '>';

  margin-left:
    0.5rem;

  color:
    rgb(var(--px-cyan));

  font-family:
    'JetBrains Mono',
    monospace;
}


/* ================================================================
   LINKS
================================================================ */

.pixel-prose :global(a) {

  color:
    rgb(var(--px-orange));

  font-weight:
    600;

  text-decoration-thickness:
    2px;

  text-underline-offset:
    4px;

  transition:
    color 0.12s ease,
    background 0.12s ease;
}

.pixel-prose :global(a:hover) {

  color:
    rgb(var(--px-cyan));

  background:
    rgb(var(--px-cyan) / 0.08);
}


/* ================================================================
   INLINE CODE
================================================================ */

.pixel-prose :global(code:not(pre code)) {

  padding:
    0.18em 0.4em;

  background:
    rgb(var(--px-panel-raised));

  border:
    1px solid rgb(var(--px-border));

  color:
    rgb(var(--px-orange));

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.88em;

  word-break:
    break-word;
}


/* ================================================================
   CODE BLOCK
================================================================ */

.pixel-prose :global(pre) {

  position:
    relative;

  display:
    block;

  width:
    100%;

  max-width:
    100%;

  margin:
    3rem 0 3.5rem;

  padding:
    3.35rem 0.25rem 1.25rem;

  box-sizing:
    border-box;

  overflow-x:
    auto;

  overflow-y:
    hidden;

  background:
    rgb(var(--px-panel));

  border:
    2px solid rgb(var(--px-border));

  box-shadow:
    6px 6px 0 rgb(var(--px-border));

  color:
    rgb(var(--color-text-body));

  font-family:
    'JetBrains Mono',
    monospace;

  font-size:
    0.82rem;

  font-weight:
    500;

  line-height:
    1.75;

  text-align:
    left;

  white-space:
    pre;

  tab-size:
    4;

  scrollbar-width:
    thin;

  scrollbar-color:
    rgb(var(--px-cyan))
    rgb(var(--px-panel));

  -webkit-overflow-scrolling:
    touch;
}


/* ================================================================
   CODE HEADER
================================================================ */

.pixel-prose :global(pre)::before {

